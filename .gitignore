# ─── Secrets & credentials ───────────────────────────────────────────────
# Real values never get committed. Copy the *.example template to .env and
# fill it in locally; the real file is ignored below.
.env
.env.*
!.env.example
!.env.*.example
*.env
.netrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
secrets.yaml
k8s-manifests/*secret*.yaml
!k8s-manifests/secrets.example.yaml

# ─── Python ──────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ─── Node / Next.js ──────────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Logs, OS, editors ───────────────────────────────────────────────────
*.log
nohup.out
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ─── Project-specific ────────────────────────────────────────────────────
monitoring/*/data
backend/workspace/